            if search_text:
                query += " AND (name LIKE ? OR alias LIKE ?)"
                params.extend([f"%{search_text}%", f"%{search_text}%"])

            cursor.execute(query, params)
            row = cursor.fetchone()
            return row[0] if row else 0
