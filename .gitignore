# ===============================================
# PROJECT SPECIFIC IGNORES
# ===============================================

# Hunt logs (runtime generated)
# Prefer ignoring entire logs directory
logs/
logs/**/*.log
logs/**/*.jsonl
logs/**/*.txt

# BUT allow example/template files to be tracked
!logs/.gitkeep
!logs/README.md
!logs/hunt_structured.example.jsonl

# Legacy single-file log patterns (kept for safety)
hunt.log
hunt.log.*
hunt_structured.jsonl
hunt_structured.jsonl.*

# Backup files
*.backup
*.bak
*.old
*.orig

# Configuration backups (keep templates only)
config.json.backup
hunt_config.json.backup
monsters.json.backup
skills.json.backup

# Temporary files
*.tmp
*.temp
temp/
tmp/
~$*
*.swp
*.swo
*.log
*.jsonl
# Screenshots and captured images (optional - uncomment if you don't want to track them)
# screenshots/
# captures/

# Test outputs
test_output/
test_results/
*.test
coverage/
.coverage
.pytest_cache/

# Performance profiling
*.prof
*.pstats

# Database files (if any)
*.db
*.sqlite
*.sqlite3

# Session files
*.session
session_*.json

# Cache files
.cache/
*.cache

